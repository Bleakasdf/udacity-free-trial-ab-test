model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures

expression DataFolder = "C:\path\to\udacity-free-trial-ab-test\data\powerbi" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

ref table group_summary
ref table metric_results
ref table decision_summary
ref table sanity_checks
ref table funnel
ref table daily_mature_metrics
